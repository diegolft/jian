# pnpm run setup generates random local credentials without overwriting .env.
ELOS_API_TOKEN=replace-with-a-random-token-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://elos:replace-with-a-random-database-password@localhost:5432/elos
HOST=127.0.0.1
PORT=4310
ELOS_ROLE=all
# Each profile references one ELOS_PROVIDER_* environment variable by name.
ELOS_PROVIDER_OPENAI=
ELOS_PROVIDER_ANTHROPIC=
ELOS_PROVIDER_GOOGLE=
# For a local compatible server without auth, a nonempty dummy key is acceptable.
# ELOS_PROVIDER_LOCAL=local
# ELOS_MCP_DOCS=
