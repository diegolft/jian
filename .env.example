# pnpm setup creates local credentials and adds a missing encryption keyring.
ELOS_API_TOKEN=replace-with-a-random-token-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://elos:replace-with-a-random-database-password@localhost:5432/elos
HOST=127.0.0.1
PORT=4310
ELOS_ROLE=all
# Optional provider credentials. The Providers screen detects them automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_API_TOKEN=
GEMINI_API_TOKEN=
# For a local compatible server without auth, a nonempty dummy key is acceptable.
# ELOS_PROVIDER_LOCAL=local
# ELOS_MCP_DOCS=

# pnpm setup generates a 32-byte key. Keep this keyring OUTSIDE database backups.
# Preserve old entries until every credential has been rotated.
ELOS_ACTIVE_KEY_ID=v1
ELOS_MASTER_KEYS='{"v1":"replace-with-base64-encoded-32-random-bytes"}'
# Exact origins, host-admin only. Metadata endpoints remain blocked.
ELOS_ALLOW_PRIVATE_ORIGINS=

# Optional: absolute Chromium/Chrome executable path on WhatsApp workers.
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
ELOS_WHATSAPP_CHROMIUM=/usr/bin/chromium
